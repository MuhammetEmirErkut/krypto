// Krypto Programming Language - Control Flow Example
// Demonstrates for loops, while loops, and conditionals

fun main() {
    print("--- For Loop Example ---");
    // C-style for loop: for (init; condition; update)
    for (let i: int = 0; i < 5; i = i + 1) {
        print(i);
    }

    print("--- While Loop Example ---");
    let count: int = 5;
    while (count > 0) {
        print(count);
        count = count - 1;
    }

    print("--- Nested Loops and Logic ---");
    for (let x: int = 1; x <= 3; x = x + 1) {
        let row: string = "";
        for (let y: int = 1; y <= 3; y = y + 1) {
            if (x == y) {
                print("Diagonal element found at:");
                print(x);
            }
        }
    }
}
