// Bubble Sort Algorithm
// Repeatedly swaps adjacent elements if they are in wrong order

fun swap(arr: int[], i: int, j: int) {
    let temp: int = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}

fun bubbleSort(arr: int[], n: int) {
    for (let i: int = 0; i < n - 1; i = i + 1) {
        for (let j: int = 0; j < n - i - 1; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                swap(arr, j, j + 1);
            }
        }
    }
}

fun printArray(arr: int[], n: int) {
    for (let i: int = 0; i < n; i = i + 1) {
        print(arr[i]);
    }
}

fun main() {
    let arr: int[] = [64, 34, 25, 12, 22, 11, 90];
    let n: int = 7;
    
    print("Original array:");
    printArray(arr, n);
    
    bubbleSort(arr, n);
    
    print("Sorted array:");
    printArray(arr, n);
}

