// Krypto Programming Language - OOP Example

interface Animal {
    void fun makeSound()
    void fun move()
}

class Dog implements Animal {
    name: string
    age: int

    void fun makeSound() {
        print("Woof!")
    }

    void fun move() {
        print("Running...")
    }

    void fun bark() {
        print(name)
        print(" says: Woof!")
    }
}

class Cat implements Animal {
    name: string

    void fun makeSound() {
        print("Meow!")
    }

    void fun move() {
        print("Walking gracefully...")
    }
}

