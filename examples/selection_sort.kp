// Selection Sort Algorithm
// Finds minimum element and places it at the beginning

fun findMinIndex(arr: int[], start: int, n: int) -> int {
    let minIdx: int = start;
    let minVal: int = arr[start];
    
    for (let i: int = start + 1; i < n; i = i + 1) {
        if (arr[i] < minVal) {
            minVal = arr[i];
            minIdx = i;
        }
    }
    
    return minIdx;
}

fun swap(arr: int[], i: int, j: int) {
    let temp: int = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}

fun selectionSort(arr: int[], n: int) {
    for (let i: int = 0; i < n - 1; i = i + 1) {
        let minIdx: int = findMinIndex(arr, i, n);
        swap(arr, i, minIdx);
    }
}

fun printArray(arr: int[], n: int) {
    for (let i: int = 0; i < n; i = i + 1) {
        print(arr[i]);
    }
}

fun main() {
    let arr: int[] = [64, 25, 12, 22, 11];
    let n: int = 5;
    
    print("Original array:");
    printArray(arr, n);
    
    selectionSort(arr, n);
    
    print("Sorted array:");
    printArray(arr, n);
}