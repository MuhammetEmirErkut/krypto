let x: int = 10;
let y: float = 3.14;
let msg: string = "Hello";
let b: bool = true;

fun add(a: int, b: int) -> int {
    return a + b;
}

let sum: int = add(x, 20);

if (b) {
    print(msg);
} else {
    print("False");
}

fun factorial(n: int) -> int {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

print("All types correct!");
